---
import '../styles/global.css';

interface Props {
  title: string;
  activePage: 'home' | 'coming-soon' | 'about' | 'support';
}

const { title, activePage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Made by CKT</title>
    <meta name="description" content="Made by CKT Ltd is a small app studio based in Shropshire, UK, designing and developing apps for pleasure and for business, one niche at a time." />
    <link rel="icon" href="/Logo2.PNG" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="Made by CKT home">
          <img src="/Logo3.PNG" alt="Made by CKT logo" width="72" height="72" />
          <span class="wordmark-text">Made by <span class="c">C</span><span class="k">K</span><span class="t">T</span></span>
        </a>
        <nav class="site-nav">
          <a href="/" aria-current={activePage === 'home' ? 'page' : undefined}>Home</a>
          <a href="/coming-soon" aria-current={activePage === 'coming-soon' ? 'page' : undefined}>Coming Soon</a>
          <a href="/about" aria-current={activePage === 'about' ? 'page' : undefined}>About</a>
          <a href="/support" aria-current={activePage === 'support' ? 'page' : undefined}>Support</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales</span>
        <span>Shropshire, UK · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a></span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
