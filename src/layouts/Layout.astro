---
import '../styles/global.css';

interface Props {
  title: string;
  activePage: 'home' | 'about' | 'support';
}

const { title, activePage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Made by CKT</title>
    <meta name="description" content="Made by CKT - a small studio that builds things that hold up." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;900&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">Made by <span>CKT</span></a>
        <nav class="site-nav">
          <a href="/" aria-current={activePage === 'home' ? 'page' : undefined}>Home</a>
          <a href="/about" aria-current={activePage === 'about' ? 'page' : undefined}>About</a>
          <a href="/support" aria-current={activePage === 'support' ? 'page' : undefined}>Support</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>Made by CKT</span>
        <span>support@madebyckt.com</span>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
