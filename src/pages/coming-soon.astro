---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Coming Soon" activePage="coming-soon">
  <header class="page-header">
    <div class="wrap">
      <div class="page-header-content">
        <div class="page-accent-marks" aria-hidden="true">
          <span class="m3"></span>
          <span class="m1"></span>
          <span class="m2"></span>
        </div>
        <h1>Coming Soon to <span class="title-ckt"><span class="c">C</span><span class="k">K</span><span class="t">T</span></span></h1>
      </div>
    </div>
  </header>

  <section class="coming-soon wrap">
    <div class="coming-soon-card" aria-label="Coming soon announcement card">
      <span class="edge-shape edge-shape--orange" aria-hidden="true"></span>
      <span class="edge-shape edge-shape--pink" aria-hidden="true"></span>
      <span class="edge-shape edge-shape--blue" aria-hidden="true"></span>
      <span class="edge-shape edge-shape--peach" aria-hidden="true"></span>

      <div class="card-content">
        <p class="eyebrow">Currently Creating, Chaos imminent</p>
        <h2>Coming Soon</h2>
        <p>Something exciting is on the horizon</p>
      </div>
    </div>

    <div class="logo-reveal-wrap" aria-label="Company logo and preview">
      <p class="hover-hint">Hover Here for a Sneek Peek</p>
      <figure class="logo-reveal-figure">
        <img src="/Logo.PNG" alt="Made by CKT logo" class="logo-base" />
        <img src="/bike.JPG" alt="Bike preview artwork" class="logo-hover" />
      </figure>
    </div>
  </section>
</Layout>
