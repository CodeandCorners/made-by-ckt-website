---
import Layout from '../layouts/Layout.astro';
import LottieMark from '../components/LottieMark.astro';
---

<Layout title="Home" activePage="home">
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>Small studio. Sharp niches.</h1>
        <p>
          Made by CKT is a UK app studio that designs, builds, and ships apps
          for pleasure and for business — the kind that serve a specific
          niche properly, instead of trying to be everything to everyone.
        </p>
        <a class="button" href="/support">Get in touch</a>
      </div>
      <div class="mark-holder">
        <LottieMark id="pulse-mark" src="/lottie/ai.json" />
      </div>
    </div>
  </section>

  <section class="offerings">
    <div class="wrap">
      <ul>
        <li>
          <h2>Design</h2>
          <p>
            We start from the niche, not the template — working out what a
            specific group of riders, hobbyists, or small businesses actually
            need before a single screen gets drawn.
          </p>
        </li>
        <li>
          <h2>Build</h2>
          <p>
            iOS-first development, built to be maintained rather than
            patched — clean data models, sensible defaults, and interfaces
            that hold up after the first release.
          </p>
        </li>
        <li>
          <h2>Support</h2>
          <p>
            Every app we ship keeps a direct line to the studio. We fix
            things fast, and we tell you when we won't be able to.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="offerings">
    <div class="wrap">
      <ul>
        <li>
          <h2>Currently building</h2>
          <p>
            <strong>Bike AI</strong> — an iOS app in active development for
            riders who want a more useful way to plan, log, and make sense of
            their time on the road. Built around on-device AI, it keeps the
            details that matter close at hand without turning the experience
            into a generic ride tracker. More details will land here as it
            nears release.
          </p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
