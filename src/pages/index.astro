---
import Layout from '../layouts/Layout.astro';
import LottieMark from '../components/LottieMark.astro';
---

<Layout title="Home" activePage="home">
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>We build, test, and deploy.</h1>
        <p>Apps, websites, and tools that work.</p>
        <a class="button" href="/support">Get in touch</a>
      </div>
      <div class="mark-holder">
        <LottieMark id="pulse-mark" src="/lottie/ai.json" />
      </div>
    </div>
  </section>

  <section class="offerings">
    <div class="wrap">
      <ul>
        <li>
          <h2>Build</h2>
          <p>We build apps, websites, and tools.</p>
        </li>
        <li>
          <h2>Test</h2>
          <p>We test them properly.</p>
        </li>
        <li>
          <h2>Deploy</h2>
          <p>We deploy them for you.</p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
