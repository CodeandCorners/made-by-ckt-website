---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" activePage="home">
  <section class="hero">
    <div class="hero-shapes" aria-hidden="true">
      <span class="shape-blue"></span>
      <span class="shape-pink"></span>
      <span class="shape-pink-right"></span>
      <span class="shape-left-pink"></span>
      <span class="shape-left-blue"></span>
      <span class="shape-peach"></span>
    </div>
    <div class="wrap">
      <div>
        <div class="accent-marks" aria-hidden="true">
          <span class="m1"></span>
          <span class="m2"></span>
          <span class="m3"></span>
        </div>
        <h1>
          Made by <span class="c">C</span><span class="k">K</span><span class="t">T</span>
        </h1>
        <p>Apps made with curiosity, creativity and a tiny bit of chaos</p>
        <a class="button" href="#currently-building">Explore what&rsquo;s coming soon</a>
      </div>
      <div class="hero-visual">
        <img class="hero-image" src="/Logo2.PNG" alt="Made by CKT brand mark" />
      </div>
    </div>
  </section>

  <section class="offerings">
    <div class="wrap">
      <ul>
        <li>
          <h2>Design</h2>
          <p>
            We start from the niche, not the template — working out what a
            specific group of riders, hobbyists, or small businesses actually
            need before a single screen gets drawn.
          </p>
        </li>
        <li>
          <h2>Build</h2>
          <p>
            iOS-first development, built to be maintained rather than
            patched — clean data models, sensible defaults, and interfaces
            that hold up after the first release.
          </p>
        </li>
        <li>
          <h2>Support</h2>
          <p>
            Every app we ship keeps a direct line to the studio. We fix
            things fast, and we tell you when we won't be able to.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="offerings" id="currently-building">
    <div class="wrap">
      <ul>
        <li>
          <h2>Currently building</h2>
          <p>
            <strong>Bike AI</strong> — an iOS app in active development for
            riders who want a more useful way to plan, log, and make sense of
            their time on the road. Built around on-device AI, it keeps the
            details that matter close at hand without turning the experience
            into a generic ride tracker. More details will land here as it
            nears release.
          </p>
        </li>
      </ul>
    </div>
  </section>
</Layout>
