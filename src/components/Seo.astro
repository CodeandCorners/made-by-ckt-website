---
/*
 * Render SEO and Open Graph meta tags for the document head.
 * The canonical URL is generated from site.url and the current path.
 */
import { site } from '../site.config';

interface Props {
	/** Page-specific title. Uses the full site title when omitted. */
	title?: string;
	description?: string;
	/** Open Graph image as an absolute URL or site-root-relative path. */
	image?: string;
	/** Open Graph type. Use 'article' for article pages. */
	type?: 'website' | 'article';
	/** Set noindex for pages that should not be indexed. */
	noindex?: boolean;
	/** Article metadata used when type is 'article'. */
	article?: {
		publishedTime?: Date;
		modifiedTime?: Date;
		author?: string;
		tags?: string[];
	};
}

const {
	title,
	description = site.description,
	image = site.defaultOgImage,
	type = 'website',
	noindex = false,
	article,
} = Astro.props;

// Apply the title template when a page-specific title is provided.
const fullTitle = title ? site.titleTemplate.replace('%s', title) : site.title;

// Fall back to site.config when Astro.site is not configured.
const baseUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, baseUrl).href.replace(/(?<!:)\/{2,}/g, '/');
const ogImage = image ? new URL(image, baseUrl).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={site.locale} />
{ogImage && <meta property="og:image" content={ogImage} />}

{/* Article metadata */}
{
	type === 'article' && article && (
		<>
			{article.publishedTime && (
				<meta property="article:published_time" content={article.publishedTime.toISOString()} />
			)}
			{article.modifiedTime && (
				<meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
			)}
			{article.author && <meta property="article:author" content={article.author} />}
			{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		</>
	)
}

{/* Twitter */}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{site.social.twitter && <meta name="twitter:site" content={site.social.twitter} />}
