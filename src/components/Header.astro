---
import Logo from './Logo.astro';

// Use root-relative anchors so landing-page sections work from nested pages.
const links = [
	{ href: '/#features', label: 'Features' },
	{ href: '/#showcase', label: 'Showcase' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/work', label: 'Work' },
	{ href: '/#pricing', label: 'Pricing' },
	{ href: '/#faq', label: 'FAQ' },
];
---

<nav
	id="site-nav"
	class="sticky top-0 z-50 border-b-[3px] border-orange bg-ink/96 backdrop-blur-xl transition-shadow duration-250"
>
	<div class="mx-auto flex max-w-[1200px] items-center gap-8 px-8 py-4">
		<Logo />
		<div class="hidden gap-7 text-[15px] font-semibold md:flex">
			{links.map((link) => <a href={link.href} class="text-sky hover:text-orange">{link.label}</a>)}
		</div>

	</div>
</nav>

<script>
	// Add a shadow after the page has been scrolled slightly.
	const nav = document.getElementById('site-nav');
	const onScroll = () => {
		if (!nav) return;
		nav.style.boxShadow = window.scrollY > 8 ? '0 6px 20px rgb(15 30 66 / 0.25)' : 'none';
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>
